PORT=3012
CLARA_BASE_URL=https://public-api.br.clara.com
CLARA_CLIENT_ID=
CLARA_CLIENT_SECRET=
CLARA_CERT_PATH=secrets/publicKey-certificate.txt
CLARA_KEY_PATH=secrets/privateKey-certificate.txt
CLARA_TIMEOUT_MS=15000
CLARA_CACHE_TTL_MS=900000
# Preencha somente para contas Clara com múltiplas entidades.
CLARA_TAX_IDENTIFIER=

# Google Drive: pasta que recebe as planilhas .xlsx diárias.
# Compartilhe a pasta com a conta de serviço e mantenha estas credenciais
# somente nas variáveis de ambiente da Vercel.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_CACHE_TTL_MS=900000

# Alternativa para usar a conta pessoal via OAuth (preferida quando preenchida).
# Gere um refresh token com o escopo https://www.googleapis.com/auth/drive.readonly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Supabase Business Data. AUTH_* podem ser copiados do dash-simplificado.
# A chave de serviço é exclusiva do servidor e nunca deve receber prefixo PUBLIC_.
TOOLS_SUPABASE_URL=https://rckpuebaiswrxzmywllv.supabase.co
TOOLS_SUPABASE_ANON_KEY=
TOOLS_SUPABASE_SERVICE_ROLE_KEY=
TOOLS_SUPABASE_SCHEMA=_dashboard_ferramentas
TOOLS_SUPABASE_ADMIN_EMAIL=matheuslacerda@quartavia.com.br
TOOLS_CRON_SECRET=
